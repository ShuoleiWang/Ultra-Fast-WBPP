{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimum desktop window capability for Ultra-Fast WBPP",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://astrometry.net/*"
        },
        {
          "url": "https://www.hnsky.org/*"
        }
      ]
    },
    "opener:allow-reveal-item-in-dir"
  ]
}
