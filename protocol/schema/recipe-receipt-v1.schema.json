{
  "$id": "https://openastroflow.org/schema/v1/recipe-receipt-v1.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Immutable identity binding for the recipe snapshot consumed by a run.",
  "properties": {
    "recipeId": {
      "type": "string"
    },
    "recipeSha256": {
      "type": "string"
    },
    "schemaVersion": {
      "format": "uint16",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "recipeId",
    "recipeSha256",
    "schemaVersion"
  ],
  "title": "RecipeReceipt",
  "type": "object",
  "x-openastroflow-schema-version": 1
}
