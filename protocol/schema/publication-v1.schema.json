{
  "$id": "https://openastroflow.org/schema/v1/publication-v1.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "PublicationFile": {
      "additionalProperties": false,
      "properties": {
        "destinationRelativePath": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "sizeBytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "sourceRelativePath": {
          "type": "string"
        }
      },
      "required": [
        "destinationRelativePath",
        "sha256",
        "sizeBytes",
        "sourceRelativePath"
      ],
      "type": "object"
    }
  },
  "properties": {
    "destinationName": {
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/definitions/PublicationFile"
      },
      "type": "array"
    },
    "publicationId": {
      "type": "string"
    },
    "schemaVersion": {
      "format": "uint16",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "destinationName",
    "files",
    "publicationId",
    "schemaVersion"
  ],
  "title": "NewDirectoryPublication",
  "type": "object",
  "x-openastroflow-schema-version": 1
}
