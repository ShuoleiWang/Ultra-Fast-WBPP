{
  "$id": "https://openastroflow.org/schema/v1/recipe-v1.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "DrizzleSettings": {
      "additionalProperties": false,
      "properties": {
        "dropShrink": {
          "default": 0.8999999761581421,
          "format": "float",
          "type": "number"
        },
        "kernel": {
          "default": "square",
          "type": "string"
        },
        "result": {
          "$ref": "#/definitions/ResultRequirement"
        },
        "scale": {
          "default": 2.0,
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "result"
      ],
      "type": "object"
    },
    "ResultRequirement": {
      "enum": [
        "disabled",
        "best-effort",
        "required"
      ],
      "type": "string"
    },
    "SolverSettings": {
      "additionalProperties": false,
      "properties": {
        "catalog": {
          "default": "gaia-dr3-offline",
          "type": "string"
        },
        "maximumRmsArcsec": {
          "default": 2.0,
          "format": "double",
          "type": "number"
        },
        "minimumMatches": {
          "default": 12,
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "projection": {
          "default": "TAN",
          "type": "string"
        },
        "result": {
          "$ref": "#/definitions/ResultRequirement"
        }
      },
      "required": [
        "result"
      ],
      "type": "object"
    },
    "StageKind": {
      "enum": [
        "ingest",
        "quality-control",
        "calibration",
        "cosmetic-correction",
        "debayer",
        "registration",
        "local-normalization",
        "integration",
        "drizzle",
        "astrometric-solve",
        "mosaic",
        "export"
      ],
      "type": "string"
    },
    "StageSpec": {
      "additionalProperties": false,
      "properties": {
        "dependsOn": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/definitions/StageKind"
        },
        "parameters": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        },
        "stageId": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "stageId"
      ],
      "type": "object"
    }
  },
  "properties": {
    "displayName": {
      "type": "string"
    },
    "drizzle": {
      "$ref": "#/definitions/DrizzleSettings"
    },
    "parameters": {
      "additionalProperties": true,
      "default": {},
      "type": "object"
    },
    "recipeId": {
      "type": "string"
    },
    "schemaVersion": {
      "format": "uint16",
      "minimum": 0.0,
      "type": "integer"
    },
    "solver": {
      "$ref": "#/definitions/SolverSettings"
    },
    "stages": {
      "items": {
        "$ref": "#/definitions/StageSpec"
      },
      "type": "array"
    }
  },
  "required": [
    "displayName",
    "drizzle",
    "recipeId",
    "schemaVersion",
    "solver",
    "stages"
  ],
  "title": "Recipe",
  "type": "object",
  "x-openastroflow-schema-version": 1
}
