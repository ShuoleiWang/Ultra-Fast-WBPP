{
  "$id": "https://openastroflow.org/schema/v1/result-gate-v1.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "GateCheck": {
      "additionalProperties": false,
      "properties": {
        "artifactIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "passed": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "passed",
        "required"
      ],
      "type": "object"
    },
    "GateDecision": {
      "enum": [
        "ready",
        "blocked"
      ],
      "type": "string"
    }
  },
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/definitions/GateCheck"
      },
      "type": "array"
    },
    "decision": {
      "$ref": "#/definitions/GateDecision"
    }
  },
  "required": [
    "checks",
    "decision"
  ],
  "title": "ResultGateReport",
  "type": "object",
  "x-openastroflow-schema-version": 1
}
