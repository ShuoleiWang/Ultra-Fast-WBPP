{
  "$id": "https://openastroflow.org/schema/v1/project-v1.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "InputRole": {
      "enum": [
        "light",
        "flat",
        "dark",
        "bias",
        "master-flat",
        "master-dark",
        "master-bias"
      ],
      "type": "string"
    },
    "ProjectSource": {
      "additionalProperties": false,
      "properties": {
        "filter": {
          "type": [
            "string",
            "null"
          ]
        },
        "hostPath": {
          "description": "Native path interpreted only by the worker running on the same host.",
          "type": "string"
        },
        "recursive": {
          "default": false,
          "type": "boolean"
        },
        "role": {
          "$ref": "#/definitions/InputRole"
        },
        "sourceId": {
          "type": "string"
        }
      },
      "required": [
        "hostPath",
        "role",
        "sourceId"
      ],
      "type": "object"
    }
  },
  "properties": {
    "createdAtUnixMs": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "displayName": {
      "type": "string"
    },
    "labels": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "type": "object"
    },
    "projectId": {
      "type": "string"
    },
    "schemaVersion": {
      "format": "uint16",
      "minimum": 0.0,
      "type": "integer"
    },
    "sources": {
      "items": {
        "$ref": "#/definitions/ProjectSource"
      },
      "type": "array"
    }
  },
  "required": [
    "createdAtUnixMs",
    "displayName",
    "projectId",
    "schemaVersion",
    "sources"
  ],
  "title": "Project",
  "type": "object",
  "x-openastroflow-schema-version": 1
}
