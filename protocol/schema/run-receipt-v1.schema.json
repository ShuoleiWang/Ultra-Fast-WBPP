{
  "$id": "https://openastroflow.org/schema/v1/run-receipt-v1.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "ArtifactDesignation": {
      "enum": [
        "intermediate",
        "diagnostic",
        "final-master"
      ],
      "type": "string"
    },
    "ArtifactKind": {
      "enum": [
        "frame-manifest",
        "quality-report",
        "master-bias",
        "master-dark",
        "master-flat",
        "calibrated-light",
        "registered-light",
        "local-normalization-model",
        "drizzle-data",
        "integration-master",
        "drizzled-master",
        "solved-master",
        "mosaic-master",
        "final-master",
        "run-log"
      ],
      "type": "string"
    },
    "ArtifactReceipt": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "astrometry": {
          "anyOf": [
            {
              "$ref": "#/definitions/AstrometricSolutionReceipt"
            },
            {
              "type": "null"
            }
          ]
        },
        "attributes": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        },
        "createdAtUnixMs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "designation": {
          "$ref": "#/definitions/ArtifactDesignation"
        },
        "drizzle": {
          "anyOf": [
            {
              "$ref": "#/definitions/DrizzleReceipt"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/definitions/ArtifactKind"
        },
        "mediaType": {
          "type": "string"
        },
        "producedByStageId": {
          "type": "string"
        },
        "relativePath": {
          "type": "string"
        },
        "schemaVersion": {
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        },
        "sha256": {
          "type": "string"
        },
        "sizeBytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "artifactId",
        "createdAtUnixMs",
        "designation",
        "kind",
        "mediaType",
        "producedByStageId",
        "relativePath",
        "schemaVersion",
        "sha256",
        "sizeBytes"
      ],
      "type": "object"
    },
    "AstrometricParity": {
      "enum": [
        "POSITIVE",
        "NEGATIVE"
      ],
      "type": "string"
    },
    "AstrometricSolutionReceipt": {
      "additionalProperties": false,
      "properties": {
        "catalogIdentity": {
          "description": "SHA-256 identity of the exact catalog rows/release used for the solve.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "catalogManaged": {
          "const": true,
          "description": "True only when the solver INDEXID is bound to app-managed index bytes.",
          "type": "boolean"
        },
        "catalogManifestSha256": {
          "description": "Digest of the checked catalog manifest that authorized those bytes.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "centerDecDegrees": {
          "format": "double",
          "type": "number"
        },
        "centerRaDegrees": {
          "format": "double",
          "type": "number"
        },
        "correspondenceSha256": {
          "description": "Digest of the correspondence table from which match/RMS evidence was recomputed.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "indexArtifacts": {
          "description": "Exact managed index artifacts selected by the backend's match table.",
          "items": {
            "$ref": "#/definitions/SolverIndexArtifactReceipt"
          },
          "minItems": 1,
          "type": "array"
        },
        "indexIdentities": {
          "description": "Backend-native index identifiers (for example INDEXID/healpix tuples).",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "installedSetIdentity": {
          "description": "Identity of the immutable installed-set receipt used for this solution.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "matchedStars": {
          "format": "uint32",
          "minimum": 3.0,
          "type": "integer"
        },
        "parity": {
          "$ref": "#/definitions/AstrometricParity"
        },
        "pixelScaleArcsec": {
          "format": "double",
          "minimum": 0.0,
          "type": "number"
        },
        "projection": {
          "minLength": 1,
          "type": "string"
        },
        "referenceFrame": {
          "minLength": 1,
          "type": "string"
        },
        "rmsArcsec": {
          "format": "double",
          "minimum": 0.0,
          "type": "number"
        },
        "rmsPixels": {
          "format": "double",
          "minimum": 0.0,
          "type": "number"
        },
        "rotationDegrees": {
          "format": "double",
          "type": "number"
        },
        "wcsSha256": {
          "description": "Digest of the canonical WCS card set embedded in the artifact.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "catalogIdentity",
        "catalogManaged",
        "catalogManifestSha256",
        "centerDecDegrees",
        "centerRaDegrees",
        "correspondenceSha256",
        "indexArtifacts",
        "indexIdentities",
        "installedSetIdentity",
        "matchedStars",
        "parity",
        "pixelScaleArcsec",
        "projection",
        "referenceFrame",
        "rmsArcsec",
        "rmsPixels",
        "rotationDegrees",
        "wcsSha256"
      ],
      "type": "object"
    },
    "DrizzleReceipt": {
      "additionalProperties": false,
      "properties": {
        "dropShrink": {
          "format": "float",
          "type": "number"
        },
        "inputFrames": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "kernel": {
          "type": "string"
        },
        "outputHeight": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "outputWidth": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "scale": {
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "dropShrink",
        "inputFrames",
        "kernel",
        "outputHeight",
        "outputWidth",
        "scale"
      ],
      "type": "object"
    },
    "HardwareProfile": {
      "description": "Stable execution profiles. Profiles describe dispatch contracts, not chip names.",
      "oneOf": [
        {
          "description": "Portable non-Windows CPU implementation, including Linux x86-64 CI.",
          "enum": [
            "portable-cpu"
          ],
          "type": "string"
        },
        {
          "description": "Portable `AArch64` CPU implementation for every Apple M-series generation and other compatible Arm64 hosts.",
          "enum": [
            "generic-arm64-cpu"
          ],
          "type": "string"
        },
        {
          "description": "Portable Metal kernels for every Apple Silicon M-series generation.",
          "enum": [
            "generic-apple-metal"
          ],
          "type": "string"
        },
        {
          "description": "Aggressively tuned Metal/CPU scheduling for Apple M3 Pro only.",
          "enum": [
            "m3-pro-tuned"
          ],
          "type": "string"
        },
        {
          "description": "Portable Windows CPU implementation (x86-64 or Arm64).",
          "enum": [
            "windows-cpu"
          ],
          "type": "string"
        }
      ]
    },
    "ProjectReceipt": {
      "additionalProperties": false,
      "description": "Immutable identity binding for the project snapshot consumed by a run.",
      "properties": {
        "capturedAtUnixMs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "inputManifestSha256": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "projectSha256": {
          "type": "string"
        },
        "resolvedSourceCount": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "schemaVersion": {
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "capturedAtUnixMs",
        "inputManifestSha256",
        "projectId",
        "projectSha256",
        "resolvedSourceCount",
        "schemaVersion"
      ],
      "type": "object"
    },
    "ReceiptError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "type": "object"
    },
    "RecipeReceipt": {
      "additionalProperties": false,
      "description": "Immutable identity binding for the recipe snapshot consumed by a run.",
      "properties": {
        "recipeId": {
          "type": "string"
        },
        "recipeSha256": {
          "type": "string"
        },
        "schemaVersion": {
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "recipeId",
        "recipeSha256",
        "schemaVersion"
      ],
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "planned",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "SolverIndexArtifactReceipt": {
      "additionalProperties": false,
      "properties": {
        "indexId": {
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        "installedSetIdentity": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "manifestSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "relativeName": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "sizeBytes": {
          "format": "uint64",
          "minimum": 1.0,
          "type": "integer"
        }
      },
      "required": [
        "indexId",
        "installedSetIdentity",
        "manifestSha256",
        "relativeName",
        "sha256",
        "sizeBytes"
      ],
      "type": "object"
    },
    "StageKind": {
      "enum": [
        "ingest",
        "quality-control",
        "calibration",
        "cosmetic-correction",
        "debayer",
        "registration",
        "local-normalization",
        "integration",
        "drizzle",
        "astrometric-solve",
        "mosaic",
        "export"
      ],
      "type": "string"
    },
    "StageReceipt": {
      "additionalProperties": false,
      "properties": {
        "artifactIds": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/definitions/ReceiptError"
            },
            {
              "type": "null"
            }
          ]
        },
        "finishedAtUnixMs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/definitions/StageKind"
        },
        "metrics": {
          "additionalProperties": {
            "format": "double",
            "type": "number"
          },
          "default": {},
          "type": "object"
        },
        "schemaVersion": {
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        },
        "stageId": {
          "type": "string"
        },
        "startedAtUnixMs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "status": {
          "$ref": "#/definitions/StageStatus"
        }
      },
      "required": [
        "kind",
        "schemaVersion",
        "stageId",
        "startedAtUnixMs",
        "status"
      ],
      "type": "object"
    },
    "StageStatus": {
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "skipped",
        "cancelled"
      ],
      "type": "string"
    }
  },
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/definitions/ArtifactReceipt"
      },
      "type": "array"
    },
    "backendId": {
      "type": "string"
    },
    "backendVersion": {
      "type": "string"
    },
    "finishedAtUnixMs": {
      "format": "uint64",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    },
    "hardwareProfile": {
      "$ref": "#/definitions/HardwareProfile"
    },
    "planId": {
      "type": "string"
    },
    "project": {
      "$ref": "#/definitions/ProjectReceipt"
    },
    "recipe": {
      "$ref": "#/definitions/RecipeReceipt"
    },
    "runId": {
      "type": "string"
    },
    "schemaVersion": {
      "format": "uint16",
      "minimum": 0.0,
      "type": "integer"
    },
    "stages": {
      "items": {
        "$ref": "#/definitions/StageReceipt"
      },
      "type": "array"
    },
    "startedAtUnixMs": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "status": {
      "$ref": "#/definitions/RunStatus"
    }
  },
  "required": [
    "artifacts",
    "backendId",
    "backendVersion",
    "hardwareProfile",
    "planId",
    "project",
    "recipe",
    "runId",
    "schemaVersion",
    "stages",
    "startedAtUnixMs",
    "status"
  ],
  "title": "RunReceipt",
  "type": "object",
  "x-openastroflow-schema-version": 1
}
