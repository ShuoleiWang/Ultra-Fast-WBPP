{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ultra-fast-wbpp:schema:sidecar-manifest-v3",
  "title": "Ultra-Fast WBPP engine runtime-tree manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "targetTriple",
    "runtime",
    "engine",
    "versions",
    "collections"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "kind": { "const": "ufwbpp-engine-sidecar" },
    "targetTriple": {
      "enum": [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "aarch64-pc-windows-msvc",
        "x86_64-pc-windows-msvc",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu"
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directoryName",
        "entryPoint",
        "treeSha256",
        "sizeBytes",
        "fileCount",
        "entryCount",
        "entries"
      ],
      "properties": {
        "directoryName": {
          "type": "string",
          "pattern": "^ufwbpp-engine-[a-zA-Z0-9_-]+$"
        },
        "entryPoint": {
          "type": "string",
          "pattern": "^ufwbpp-engine-[a-zA-Z0-9_-]+(?:\\.exe)?$"
        },
        "treeSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "fileCount": { "type": "integer", "minimum": 1 },
        "entryCount": { "type": "integer", "minimum": 1 },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "type"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "type": { "const": "directory" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "type", "target"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "type": { "const": "symlink" },
                  "target": { "type": "string", "minLength": 1 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "type", "sha256", "sizeBytes", "executable"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "type": { "const": "file" },
                  "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "sizeBytes": { "type": "integer", "minimum": 0 },
                  "executable": { "type": "boolean" }
                }
              }
            ]
          }
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "pyinstaller", "packages"],
      "properties": {
        "python": { "type": "string", "minLength": 1 },
        "pyinstaller": { "type": "string", "minLength": 1 },
        "packages": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "astropy",
            "reproject",
            "shapely",
            "light-frame-qc",
            "ufwbpp",
            "ufwbpp-registration"
          ],
          "properties": {
            "astropy": { "type": "string", "minLength": 1 },
            "reproject": { "type": "string", "minLength": 1 },
            "shapely": { "type": "string", "minLength": 1 },
            "light-frame-qc": { "type": "string", "minLength": 1 },
            "ufwbpp": { "type": "string", "minLength": 1 },
            "ufwbpp-registration": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "collections": {
      "type": "array",
      "prefixItems": [
        { "const": "ufwbpp" },
        { "const": "lightframeqc" },
        { "const": "ufwbpp_registration" },
        { "const": "astropy" },
        { "const": "reproject" },
        { "const": "shapely" }
      ],
      "items": false,
      "minItems": 6,
      "maxItems": 6
    }
  }
}
