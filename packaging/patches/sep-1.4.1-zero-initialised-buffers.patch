 #define _Atomic  // this isn't great, but we only use atomic for global settings
-#define rand_r(SEED) \
-  rand()  // MSVC doesn't provide rand_r, but makes rand safe for re-entrancy
+/* MSVC has no rand_r(). Mapping it to rand() made `randseed = 1` in
+   sep_extract() a no-op: rand() keeps per-thread state that the reset never
+   touched, so every extraction in a thread continued the previous sequence
+   and gatherup() assigned faint deblended pixels differently call to call.
+   sep_rand_r() (deblend.c) advances the caller's seed like POSIX rand_r(). */
+int sep_rand_r(unsigned int * seed);
+#define rand_r(SEED) sep_rand_r(SEED)
 #endif
