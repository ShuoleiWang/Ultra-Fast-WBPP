{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ultra-fast-wbpp:schema:installed-set-v1",
  "title": "Ultra-Fast WBPP installed solver catalog set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogId",
    "manifestSha256",
    "artifacts",
    "installedSetIdentity",
    "config",
    "provider",
    "version",
    "citation",
    "licenseStatus",
    "acceptanceId",
    "transportEvidence"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "catalogId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
    "manifestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "installedSetIdentity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "citation": {"type": "string", "minLength": 1},
    "licenseStatus": {
      "enum": ["confirmed", "provider-specific-unresolved", "review-required"]
    },
    "acceptanceId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactId", "relativePath", "sourceUrl", "sizeBytes", "sha256"],
        "properties": {
          "artifactId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "relativePath": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "sourceUrl": {"type": "string", "pattern": "^https://"},
          "sizeBytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "transportEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactId", "sourceUrl", "entityTag", "method"],
        "properties": {
          "artifactId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "sourceUrl": {"type": "string", "pattern": "^https://"},
          "entityTag": {"type": ["string", "null"]},
          "method": {"enum": ["provider-download", "existing-file-verification"]}
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "sizeBytes", "sha256"],
      "properties": {
        "relativePath": {"const": "astrometry.cfg"},
        "sizeBytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
